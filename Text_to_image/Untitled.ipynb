    "txt = input()\n",
    "image  = image.new(\"RGB\", (800,300), \"white\")\n",
    "draw = ImageDraw.Draw(image)\n",
    "font = Imagefont.Load_default()\n",
    "\n",
    "draw.text((150,100), txt, fill=\"black\", font = font)\n",
    "\n",
    "image.save(\"txt.image.png\")\n",
    "\n",
    "print(\"image generated\")"
